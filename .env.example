# Database
DATABASE_URL=postgresql+psycopg://filmoteka:filmoteka@localhost:5432/filmoteka

# Redis
REDIS_URL=redis://localhost:6379/0

# App
SECRET_KEY=change-me-to-a-random-secret
LIBRARY_SPEC_PATH=specs/library.yaml

# Media directories
DOWNLOADS_ROOT=./media/downloads
LIBRARY_ROOT=./media/library

# External metadata providers (optional)
# Get a free API key from http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# DeepSeek LLM for metadata enrichment (optional)
# Get an API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Local LLM for mood-based recommendations (optional)
# Set to a local Ollama URL e.g. http://localhost:11434
# LLM_API_URL=http://localhost:11434
